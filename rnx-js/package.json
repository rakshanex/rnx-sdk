{
  "name": "@rnx/sdk",
  "version": "0.1.0",
  "description": "RNX Testnet JS/TS SDK — read-only EVM JSON-RPC queries + pre-signed raw tx broadcast + VERIDEX currentAnchor verify. TESTNET ONLY, no private keys handled.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "example": "node example.js"
  },
  "keywords": [
    "rnx",
    "testnet",
    "evm",
    "ethers",
    "veridex"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
